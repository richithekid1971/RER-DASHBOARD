function setSort(mode,el){sortMode=mode;document.querySelectorAll('.ctrl-btn').forEach(b=>b.classList.remove('active'));el.classList.add('active');render(lastData||DEMO);}
function passes(s){return s.totalTrades>=4&&s.winRate>60&&s.lossRate<30;}
function pfClass(pf,noLoss){if(noLoss)return'pf-inf';if(pf>=3)return'pf-hi';if(pf>=2)return'pf-mid';return'pf-lo';}
function pfStr(s){if(s.grossLoss===0&&s.grossWin>0)return'∞';if(s.pf===0&&s.totalTrades===0)return'—';return s.pf.toFixed(2);}
function barColor(wr){if(wr>70)return'#22c55e';if(wr>60)return'#86efac';if(wr>50)return'#f59e0b';return'#ef4444';}
function fmt$(n){if(n===undefined||n===null)return'—';const a=Math.abs(n).toLocaleString('es-ES',{minimumFractionDigits:2,maximumFractionDigits:2});return(n>=0?'+$':'-$')+a;}
function sortSystems(arr,mode){
  const a=[...arr];
  if(mode==='pf')return a.sort((x,y)=>(y.pf||0)-(x.pf||0));
  if(mode==='profit')return a.sort((x,y)=>y.netProfit-x.netProfit);
  if(mode==='winrate')return a.sort((x,y)=>y.winRate-x.winRate);
  return a.sort((x,y)=>(y.totalTrades*(y.winRate/100))-(x.totalTrades*(x.winRate/100)));
}

function render(data){
