  const systems=data.systems||[];
  const bal=data.balance||0,eq=data.equity||0;
  document.getElementById('mBalance').textContent='$'+bal.toLocaleString('es-ES',{minimumFractionDigits:2,maximumFractionDigits:2});
  document.getElementById('mAccount').textContent=data.account||'';
  document.getElementById('mEquity').textContent='$'+eq.toLocaleString('es-ES',{minimumFractionDigits:2,maximumFractionDigits:2});
  const diff=eq-bal;const de=document.getElementById('mEquityDiff');
  de.textContent=fmt$(diff)+' vs balance';de.style.color=diff>=0?'var(--green)':'var(--red)';
  const withTrades=systems.filter(s=>s.totalTrades>0);
  const passing=withTrades.filter(passes);
  const min4=withTrades.filter(s=>s.totalTrades>=4);
  document.getElementById('mTotal').textContent=systems.length;
  document.getElementById('mPassing').textContent=passing.length+' cumplen Win>60% Loss<30%';
  document.getElementById('mMin4').textContent=min4.length;
  const totalOpen=systems.reduce((a,s)=>a+(s.openTrades||0),0);
  const totalOpenPL=systems.reduce((a,s)=>a+(s.openProfit||0),0);
  document.getElementById('mOpen').textContent=totalOpen;
  const oe=document.getElementById('mOpenProfit');
  oe.textContent=fmt$(totalOpenPL)+' flotante';oe.style.color=totalOpenPL>=0?'var(--green)':'var(--red)';
  const bestWR=withTrades.reduce((a,s)=>s.winRate>a.winRate?s:a,{winRate:0,name:''});
  document.getElementById('mBestWR').textContent=bestWR.winRate.toFixed(1)+'%';
  document.getElementById('mBestName').textContent=bestWR.name||'—';

  // TOP 15
  const eligible=min4;
  const sorted=sortSystems(eligible,sortMode);
  const top15=sorted.slice(0,15);
  document.getElementById('rankCount').textContent=top15.length+' de '+eligible.length;
  document.getElementById('rankBody').innerHTML=top15.map((s,i)=>{
    const rank=i+1;
    const rankCls=rank===1?'r1':rank===2?'r2':rank===3?'r3':'';
    const ok=passes(s);const rowCls=rank<=3?'top3':ok?'passes':'';
    const noLoss=s.grossLoss===0&&s.grossWin>0;
    const wrColor=barColor(s.winRate);
    const openHtml=s.openTrades>0?`<span class="open-badge"><span class="open-dot"></span>${s.openTrades} (${fmt$(s.openProfit)})</span>`:'<span style="color:var(--muted)">—</span>';
    const badgeHtml=ok?'<span class="badge badge-pass">✓ PASA</span>':'<span class="badge badge-warn">⚠ Revisar</span>';
    return`<tr class="${rowCls}">
      <td><span class="rank ${rankCls}">${rank}</span></td>
      <td><span class="sys-name">${s.name}</span><span class="sys-magic">${s.magic}</span></td>
      <td class="r" style="font-family:var(--font-mono);font-weight:700">${s.totalTrades}</td>
      <td class="r" style="color:var(--green);font-family:var(--font-mono)">${s.wins}</td>
      <td class="r" style="color:var(--red);font-family:var(--font-mono)">${s.losses}</td>
      <td style="min-width:120px"><div class="bar-wrap"><div class="bar"><div class="bar-fill" style="width:${s.winRate}%;background:${wrColor}"></div></div><span class="bar-val" style="color:${wrColor}">${s.winRate.toFixed(1)}%</span></div></td>
      <td class="r" style="color:${s.lossRate<30?'var(--green)':'var(--amber)'};font-family:var(--font-mono)">${s.lossRate.toFixed(1)}%</td>
      <td class="r"><span class="${pfClass(s.pf,noLoss)}">${pfStr(s)}</span></td>
      <td class="r"><span class="${s.netProfit>=0?'pos':'neg'}">${fmt$(s.netProfit)}</span></td>
      <td class="r">${openHtml}</td>
      <td style="text-align:center">${badgeHtml}</td>
    </tr>`;
  }).join('');

  // ALL
  const allSorted=sortSystems(systems,sortMode);
  document.getElementById('allCount').textContent=systems.length+' sistemas';
  document.getElementById('allBody').innerHTML=allSorted.map((s,i)=>{
    const ok=passes(s);const noLoss=s.grossLoss===0&&s.grossWin>0;
    const wrColor=s.totalTrades>0?barColor(s.winRate):'var(--muted)';
    const badgeHtml=s.totalTrades===0?'<span class="badge badge-nd">Sin datos</span>':ok?'<span class="badge badge-pass">✓ PASA</span>':'<span class="badge badge-warn">⚠ Revisar</span>';
    return`<tr>
      <td style="color:var(--muted);font-size:11px;font-family:var(--font-mono)">${i+1}</td>
      <td><span style="font-weight:500">${s.name}</span><span class="sys-magic">${s.magic}</span></td>
      <td class="r" style="font-family:var(--font-mono)">${s.totalTrades||'—'}</td>
      <td class="r" style="color:${wrColor};font-family:var(--font-mono);font-weight:600">${s.totalTrades>0?s.winRate.toFixed(1)+'%':'—'}</td>
      <td class="r" style="color:${s.lossRate<30&&s.totalTrades>0?'var(--green)':'var(--muted)'};font-family:var(--font-mono)">${s.totalTrades>0?s.lossRate.toFixed(1)+'%':'—'}</td>
      <td class="r"><span class="${pfClass(s.pf,noLoss)}">${pfStr(s)}</span></td>
      <td class="r"><span class="${s.netProfit>=0?'pos':'neg'}">${s.totalTrades>0?fmt$(s.netProfit):'—'}</span></td>
      <td style="text-align:center">${badgeHtml}</td>
    </tr>`;
  }).join('');
}

// Intentar conectar al servidor cada 10s; si falla, demo
async function fetchData(){
  try{
    const res=await fetch('http://localhost:8080/data',{signal:AbortSignal.timeout(3000)});
    const data=await res.json();
    lastData=data;
    document.getElementById('liveDot').className='live-dot';
    document.getElementById('liveLabel').textContent='En vivo — MT5';
    document.getElementById('lastUpdate').textContent='Actualizado '+new Date().toLocaleTimeString('es-ES');
    render(data);
  }catch(e){
    if(!lastData||lastData===DEMO){
      document.getElementById('liveDot').className='live-dot stale';
      document.getElementById('liveLabel').textContent='Modo demo';
      document.getElementById('lastUpdate').textContent='Demo — inicia server.py para datos reales';
      render(DEMO);
    }
  }
}

render(DEMO);
fetchData();
setInterval(fetchData,10000);
</script>
